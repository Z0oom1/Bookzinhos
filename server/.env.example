# Porta do servidor
PORT=3001

# --- BANCO DE DADOS ---
# SQLite Local (padrão se TURSO_DATABASE_URL não for definido)
DATA_DIR=./data

# Turso (SQLite Remoto na Nuvem - Grátis e Persistente)
# TURSO_DATABASE_URL=libsql://sua-url-aqui.turso.io
# TURSO_AUTH_TOKEN=seu-token-aqui

# --- ARMAZENAMENTO DE LIVROS (10 GB+ Grátis) ---
# S3-Compatível: Cloudflare R2 ou Backblaze B2
# S3_ACCESS_KEY_ID=seu-access-key-id
# S3_SECRET_ACCESS_KEY=seu-secret-access-key
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com ou https://s3.us-west-004.backblazeb2.com
# S3_BUCKET_NAME=bookzinhos
# S3_PUBLIC_URL_PREFIX=https://pub-seu-id.r2.dev ou prefixo amigável do B2
# S3_REGION=auto

# --- ALTERNATIVA (1 GB Grátis) ---
# SUPABASE_URL=https://sua-url.supabase.co
# SUPABASE_KEY=sua-key-anonima
# SUPABASE_SERVICE_KEY=sua-key-service-role
